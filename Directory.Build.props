<Project>
	<Target Name="UnblockResxAutomatic" BeforeTargets="BeforeBuild;GenerateResources">
		<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Get-ChildItem -Path '$(MSBuildProjectDirectory)' -Recurse -Filter *.resx | Unblock-File&quot;" ContinueOnError="true" />
	</Target>
</Project>